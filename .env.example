# Server: use an absolute path outside the repository.
HSM_HOST=127.0.0.1
HSM_PORT=8787
HSM_DATABASE_URL=sqlite:////var/lib/hsm/state.db
HSM_CREDENTIALS_FILE=/etc/hsm/credentials.json
HSM_LOG_LEVEL=INFO
# Explicitly opt into the verified Herdr interface; default is unavailable/no-op.
HSM_RUNTIME_ADAPTER=noop
# CLI/MCP: keep operator token out of agent environments.
HSM_API_URL=http://127.0.0.1:8787
HSM_TOKEN_FILE=/etc/hsm/operator.token
# Alternative server credential provisioning: HSM_CREDENTIALS JSON, default []
# Alternative client token provisioning: HSM_TOKEN, default empty
