[Unit]
Description=Herdr State Manager API
After=network.target

[Service]
Type=simple
User=hsm
Group=hsm
WorkingDirectory=/opt/hsm
EnvironmentFile=/etc/hsm/hsm.env
ExecStart=/opt/hsm/.venv/bin/gunicorn --bind 127.0.0.1:8787 --workers 2 --access-logfile - hsm.app:create_app()
Restart=on-failure
RestartSec=3
StateDirectory=hsm
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hsm

[Install]
WantedBy=multi-user.target
