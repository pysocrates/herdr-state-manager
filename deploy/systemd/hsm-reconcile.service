[Unit]
Description=HSM observational reconciliation
After=hsm.service

[Service]
Type=oneshot
User=hsm
Group=hsm
WorkingDirectory=/opt/hsm
EnvironmentFile=/etc/hsm/hsm.env
ExecStart=/opt/hsm/.venv/bin/hsm reconcile --json
StateDirectory=hsm
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hsm
